# 开发环境配置示例
# 复制此文件为 application-dev.yml 并填入真实配置

center:
  datasource:
    host: localhost
    # ⚠️ 必须是 MySQL 8.0+：Flyway 9.x 社区版不支持 MySQL 5.7，
    #    版本过低会导致 flywayInitializer 创建失败、应用无法启动
    #    （报错：Flyway Teams Edition or MySQL upgrade required）。
    #    本机开发库在 3307（MySQL 8.0）；若你的 MySQL 8.0 在 3306，请改回 3306。
    port: 3307
    database: yiya
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: your_mysql_username
    password: your_mysql_password
  aliyun:
    oss:
      endpoint: https://oss-cn-beijing.aliyuncs.com
      access-key-id: your_aliyun_access_key_id
      access-key-secret: your_aliyun_access_key_secret
      bucket-name: your_bucket_name
      region: cn-beijing
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
  redis:
    host: localhost
    port: 6379
    password: your_redis_password
    database: 1
  openai:
    base-url: https://dashscope.aliyuncs.com/compatible-mode/
    api-key: your_dashscope_api_key
    chat:
      options:
        model: qwen3.6-flash
        temperature: 0.8
    embedding:
      options:
        model: qwen3-vl-rerank
        dimensions: 1024

spring:
  datasource:
    driver-class-name: ${center.datasource.driver-class-name}
    url: jdbc:mysql://${center.datasource.host}:${center.datasource.port}/${center.datasource.database}?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: ${center.datasource.username}
    password: ${center.datasource.password}

  ai:
    openai:
      api-key: ${center.openai.api-key}
      chat:
        options:
          model: ${center.openai.chat.options.model}
          temperature: ${center.openai.chat.options.temperature:0.7}
      base-url: ${center.openai.base-url}

  session:
    timeout: 86400s
    cookie:
      max-age: 86400
      http-only: true
      secure: false
      same-site: Lax
  jwt:
    secret: your_jwt_secret_key_here_at_least_32_chars
    expiration: 86400

  data:
    redis:
      host: ${center.redis.host:localhost}
      port: ${center.redis.port:6379}
      password: ${center.redis.password:}
      database: ${center.redis.database:0}
      timeout: 3000ms
      lettuce:
        pool:
          max-active: 100
          max-idle: 10
          min-idle: 5
          max-wait: 3000ms

aliyun:
  oss:
    endpoint: ${center.aliyun.oss.endpoint}
    bucketName: ${center.aliyun.oss.bucket-name}
    region: ${center.aliyun.oss.region}
    access-key-id: ${center.aliyun.oss.access-key-id}
    access-key-secret: ${center.aliyun.oss.access-key-secret}

elasticsearch:
  host: 127.0.0.1
  port: 9200
  scheme: http
  username:
  password:

github:
  oauth:
    client-id: your_github_client_id
    client-secret: your_github_client_secret
    redirect-uri: http://localhost:5173/oauth/callback

qq:
  oauth:
    app-id: your_qq_app_id
    app-key: your_qq_app_key
    redirect-uri: http://localhost:5173/oauth/callback
